# Development-only values. Replace placeholders locally; never use in production.
POSTGRES_DB=faculty_portal
POSTGRES_USER=faculty_portal_dev
POSTGRES_PASSWORD=replace-with-local-only-password

KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-only-password

# Used when running the backend directly from the host.
DATABASE_URL=jdbc:postgresql://localhost:5432/faculty_portal
REDIS_HOST=localhost
REDIS_PORT=6379